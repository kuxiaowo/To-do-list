# Server bind address and port.
# Keep TODO_HOST as 127.0.0.1 when using a reverse proxy such as Caddy or Nginx.
TODO_HOST=127.0.0.1
TODO_PORT=8092

# NetHub Accounts OIDC. Register this exact callback and back-channel URL in
# the Accounts client before switching production traffic.
TODO_PUBLIC_URL=https://todolist.nethub.wiki
ACCOUNTS_ISSUER=https://auth.nethub.wiki
TODO_OIDC_CLIENT_ID=todo
TODO_OIDC_CLIENT_SECRET=
TODO_OIDC_REDIRECT_URI=https://todolist.nethub.wiki/auth/callback
TODO_SESSION_COOKIE_SECURE=true

# Keep false after the hard cutover. The compatibility switch exists only for
# local regression tests and emergency rollback; it must not be enabled in production.
TODO_LEGACY_AUTH_ENABLED=false

# Required before users can connect ManageBac. Generate once and keep it stable:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# MANAGEBAC_COOKIE_ENCRYPTION_KEY=replace-with-generated-key

# Optional AI configuration.
# Copy this file to .env and replace the placeholder before enabling AI features.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20

# Optional Aliyun OSS configuration for ManageBac Helper installer downloads.
# The backend signs a short-lived GetObject URL for logged-in users.
# Object key must match the RAM policy, for example: managebac-sync-helper/latest.exe
ALIYUN_OSS_ACCESS_KEY_ID=your-ram-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
ALIYUN_OSS_REGION=cn-chengdu
ALIYUN_OSS_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com
ALIYUN_OSS_BUCKET=example
ALIYUN_OSS_INSTALLER_KEY=example/setup.exe
ALIYUN_OSS_INSTALLER_FILENAME=setup.exe
ALIYUN_OSS_SIGN_EXPIRES_SECONDS=120

# Optional deploy script service name.
# Note: deploy-first-run.sh reads this in bash before server.py loads .env,
# so set it as an exported shell variable if you need a custom service name:
# TODO_SERVICE_NAME=todo-list.service
